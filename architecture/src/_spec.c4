specification {

  tag planned {
    color #8a8f98
  }
  tag open {
    color #e8a317
  }
  tag adr-0001 {
    color #8b5cf6
  }
  tag adr-0002 {
    color #8b5cf6
  }
  tag adr-0003 {
    color #8b5cf6
  }
  tag adr-0004 {
    color #8b5cf6
  }
  tag adr-0005 {
    color #8b5cf6
  }
  tag adr-0006 {
    color #8b5cf6
  }
  tag adr-0007 {
    color #8b5cf6
  }
  tag adr-0008 {
    color #8b5cf6
  }
  tag adr-0009 {
    color #8b5cf6
