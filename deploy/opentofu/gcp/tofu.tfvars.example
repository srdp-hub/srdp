acme_email     = "CHANGE_ME_EMAIL"
domain_name    = "CHANGE_ME_DOMAIN"

# Secrets. Generate them, never commit them.
zitadel_masterkey  = ""
oidc_client_id     = ""
oidc_client_secret = ""
oidc_cookie_secret = ""
