# Docker Compose project name (must be "local" so the network is named "local_app")
COMPOSE_PROJECT_NAME=local

# Masterkey for Zitadel to encrypt its data.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
ZITADEL_MASTERKEY=

# First-instance admin password. Zitadel requires uppercase, lowercase, digits,
# and at least one symbol (e.g. generate with a password manager, or by hand
# following that rule).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=

# OIDC client credentials for our forward-auth helper
OIDC_CLIENT_ID=myOidcClientIdChangeMe # Change based on the client ID shown in Zitadel
OIDC_CLIENT_SECRET=myOidcClientSecretChangeMe # Change based on the client ID shown in Zitadel

# Cookie secret for oauth2-proxy's session cookie.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
OIDC_COOKIE_SECRET=

# Shared Postgres. POSTGRES_PASSWORD is the superuser (also used by DuckLake's
# catalog metadata connection). The others are per-service roles, created by
# srdp-setup. Generate each with:
# tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24
POSTGRES_PASSWORD=
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
DAGSTER_PG_PASSWORD=
MARQUEZ_DB_PASSWORD=

# DuckLake storage. `local` (the default) keeps the Parquet files in the
# ducklake-data volume. `s3` moves them to a bucket. For the bundled Garage
# server, also set COMPOSE_PROFILES=s3 and fill in the four Garage keys below.
# The DUCKLAKE_S3_* settings default to that Garage (bucket ducklake, endpoint
# garage:3900, region garage, path-style, no TLS), so only set them for other
# storage.
# COMPOSE_PROFILES=s3
DUCKLAKE_STORAGE_BACKEND=local
# DUCKLAKE_S3_BUCKET=ducklake
# DUCKLAKE_S3_PREFIX=compose
# DUCKLAKE_S3_ENDPOINT=garage:3900
# DUCKLAKE_S3_URL_STYLE=path
# Keep the region `garage` with the bundled Garage, it must match s3_region in
# deploy/docker/garage.toml because DuckDB signs every request with it.
# DUCKLAKE_S3_REGION=garage
# DUCKLAKE_S3_USE_SSL=false

# One key pair per role. dagster-code gets the writer key, marimo, streamlit,
# the api and duckdb-ui the read-only key. Garage wants a key id of GK plus
# 24 hex characters and a 64-hex-character secret:
#   echo GK$(openssl rand -hex 12)
#   openssl rand -hex 32
DUCKLAKE_S3_WRITER_KEY_ID=
DUCKLAKE_S3_WRITER_SECRET=
DUCKLAKE_S3_READER_KEY_ID=
DUCKLAKE_S3_READER_SECRET=

# The bundled Garage's own secrets, only with COMPOSE_PROFILES=s3. A set
# GARAGE_ADMIN_TOKEN also switches on srdp-setup's Garage step, which waits for
# Garage, so leave it empty without the s3 profile.
#   GARAGE_RPC_SECRET: openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN: openssl rand -hex 16
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
