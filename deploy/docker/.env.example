# Docker Compose project name (must be "local" so the network is named "local_app")
COMPOSE_PROJECT_NAME=local

# Masterkey for Zitadel to encrypt its data.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
ZITADEL_MASTERKEY=

# First-instance admin password. Zitadel requires uppercase, lowercase, digits,
# and at least one symbol (e.g. generate with a password manager, or by hand
# following that rule).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=

# OIDC client credentials for our forward-auth helper
OIDC_CLIENT_ID=myOidcClientIdChangeMe # Change based on the client ID shown in Zitadel
OIDC_CLIENT_SECRET=myOidcClientSecretChangeMe # Change based on the client ID shown in Zitadel

# Cookie secret for oauth2-proxy's session cookie.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
OIDC_COOKIE_SECRET=

# The Postgres superuser (never given to Zitadel) and the roles srdp-setup creates. Generate each with:
# tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24
POSTGRES_PASSWORD=
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
DAGSTER_PG_PASSWORD=
MARQUEZ_DB_PASSWORD=

# local or s3. The bundled Garage also needs COMPOSE_PROFILES and SETUP_GARAGE_ENABLED.
# COMPOSE_PROFILES=s3
# SETUP_GARAGE_ENABLED=true
DUCKLAKE_STORAGE_BACKEND=local
# Defaults point to the bundled Garage.
# DUCKLAKE_S3_BUCKET=ducklake
# DUCKLAKE_S3_PREFIX=compose
# DUCKLAKE_S3_ENDPOINT=garage:3900
# DUCKLAKE_S3_URL_STYLE=path
# DUCKLAKE_S3_REGION=garage
# DUCKLAKE_S3_USE_SSL=false

# Only Dagster gets the writer key. Garage key id: echo GK$(openssl rand -hex 12), secret: openssl rand -hex 32
DUCKLAKE_S3_WRITER_KEY_ID=
DUCKLAKE_S3_WRITER_SECRET=
DUCKLAKE_S3_READER_KEY_ID=
DUCKLAKE_S3_READER_SECRET=

# Bundled Garage only. RPC secret: openssl rand -hex 32, admin token: openssl rand -hex 16
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Production only (docker-compose.prod.yml). Let's Encrypt's contact address,
# required there. ACME_CA_SERVER is optional and defaults to Let's Encrypt
# production. Set it to the staging directory to try out a new domain:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=
# ACME_CA_SERVER=

# The domain, required by docker-compose.yml. The just recipes set it from
# srdp.toml, so set it here only when running docker compose without just.
# SRDP_DOMAIN=

# Platform images (srdp-setup, dagster-webserver, duckdb-ui, hub). `just docker-up`
# builds them from source and tags them dev. `just docker-up-release <version>`
# pulls that release from the registry below instead.
# SRDP_PLATFORM_REGISTRY=ghcr.io/srdp-hub
