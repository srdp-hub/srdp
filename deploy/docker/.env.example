# `just docker-up` generates every empty password, key and token below once, from the
# list in deploy/secrets.toml. A value you set yourself stays. Each name is the
# Kubernetes Secret without "srdp-" plus its key, so srdp-zitadel/db-password is
# ZITADEL_DB_PASSWORD.

# The master key Zitadel encrypts its data with, 32 characters.
ZITADEL_MASTERKEY=

# The password of the first Zitadel admin. Zitadel requires uppercase, lowercase,
# digits and a symbol.
ZITADEL_ADMIN_PASSWORD=

# The OIDC client of oauth2-proxy. These start as CHANGE_ME_ placeholders, and
# provision-oidc.sh replaces them with the client that Zitadel creates.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# The secret of the oauth2-proxy session cookie, 32 characters.
OAUTH2_PROXY_COOKIE_SECRET=

# The Postgres superuser (never given to Zitadel) and the roles srdp-setup creates.
POSTGRES_PASSWORD=
ZITADEL_DB_PASSWORD=
DAGSTER_POSTGRESQL_PASSWORD=
MARQUEZ_DB_PASSWORD=
# The DuckLake catalog roles. Dagster writes as the writer, and the apps read as the reader.
DUCKLAKE_PG_WRITER_PASSWORD=
DUCKLAKE_PG_READER_PASSWORD=

# local or s3. The bundled Garage also needs COMPOSE_PROFILES and SETUP_GARAGE_ENABLED.
# COMPOSE_PROFILES=s3
# SETUP_GARAGE_ENABLED=true
DUCKLAKE_STORAGE_BACKEND=local
# Defaults point to the bundled Garage.
# DUCKLAKE_S3_BUCKET=ducklake
# DUCKLAKE_S3_PREFIX=compose
# DUCKLAKE_S3_ENDPOINT=garage:3900
# DUCKLAKE_S3_URL_STYLE=path
# DUCKLAKE_S3_REGION=garage
# DUCKLAKE_S3_USE_SSL=false

# Only Dagster gets the writer key. A Garage key id is GK plus 24 hex characters.
DUCKLAKE_S3_WRITER_KEY_ID=
DUCKLAKE_S3_WRITER_SECRET=
DUCKLAKE_S3_READER_KEY_ID=
DUCKLAKE_S3_READER_SECRET=

# Bundled Garage only.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Production only (docker-compose.prod.yml). Let's Encrypt's contact address,
# required there. ACME_CA_SERVER is optional and defaults to Let's Encrypt
# production. Set it to the staging directory to try out a new domain:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=
# ACME_CA_SERVER=

# The domain, required by docker-compose.yml. The just recipes set it from
# srdp.toml, so set it here only when running docker compose without just.
# SRDP_DOMAIN=

# Platform images (srdp-setup, dagster-webserver, duckdb-ui, hub). `just docker-up`
# builds them from source and tags them dev. `just docker-up-release <version>`
# pulls that release from the registry below instead.
# SRDP_PLATFORM_REGISTRY=ghcr.io/srdp-hub
